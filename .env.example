# ── Frontend (Vite) ─────────────────────────────────────────────
# URL бэкенда. Пусто → приложение работает на встроенном мок-слое
# (данные сохраняются в Telegram CloudStorage пользователя).
VITE_API_URL=
# Username бота без @ и short name Mini App из BotFather (для реферальных ссылок)
VITE_BOT_USERNAME=
VITE_APP_SHORTNAME=
# Канал школы для задания «Подписаться»
VITE_CHANNEL_URL=https://t.me/telegram
# Username куратора для записи на консультации (без @)
VITE_CURATOR_USERNAME=

# ── Server ─────────────────────────────────────────────────────
BOT_TOKEN=
# Публичный HTTPS-адрес фронтенда (GitHub Pages / Vercel)
WEBAPP_URL=
# Куда присылать уведомления о лидах и покупках (ваш chat_id)
ADMIN_CHAT_ID=
# @username или -100… id канала для проверки подписки (бот должен быть админом)
CHANNEL_ID=
PORT=8080
# Разрешённые origin'ы для CORS через запятую
CORS_ORIGINS=
# Включить long polling бота (false — только API)
BOT_POLLING=true
